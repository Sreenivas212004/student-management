<script>
document
    .getElementById("exportStudentsBtn")
    ?.addEventListener("click", function () {

        const form = document.querySelector(
            ".student-filter-form"
        );

        if (!form) {
            return;
        }

        const params = new URLSearchParams(
            new FormData(form)
        );

        const exportUrl =
            "<?= $this->url('student', [
                'action' => 'export'
            ]) ?>";

        window.location.href =
            exportUrl + "?" + params.toString();
    });
</script>