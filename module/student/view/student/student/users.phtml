                            $user->created_at
                            ?? $user['created_at']
                            ?? '';

                        $lastLogin =
                            $user->last_login
                            ?? $user['last_login']
                            ?? null;

                        $isActive =
                            $userStatus === 'active';
                        ?>


                        <tr>

                            <!-- ID -->

                            <td class="user-id">
                                <?= $this->escapeHtml($userId) ?>
                            </td>


