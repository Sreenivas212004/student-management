<!-- ==========================================
     LOCATION JAVASCRIPT
     ========================================== -->

<script>

const addressBox =
    document.getElementById("address");

const status =
    document.getElementById("locationStatus");

const latitudeBox =
    document.getElementById("latitude");

const longitudeBox =
    document.getElementById("longitude");


// ========================================
// CURRENT LOCATION
// ========================================

document
    .getElementById("getLocationBtn")
    .addEventListener("click", function () {

        if (!navigator.geolocation) {

            status.textContent =
                "Geolocation is not supported by your browser.";

            return;
        }

        status.textContent =
            "Getting your current location...";


        navigator.geolocation.getCurrentPosition(

            function (position) {

                const latitude =
                    position.coords.latitude;

                const longitude =
                    position.coords.longitude;


                latitudeBox.value =
                    latitude;

                longitudeBox.value =
                    longitude;


                status.textContent =
                    "Location detected successfully.";
            },


            function () {

                status.textContent =
                    "Unable to get your current location.";
            }

        );

    });


// ========================================
// SEARCH ADDRESS
// ========================================

document
    .getElementById("searchAddressBtn")
    .addEventListener("click", function () {

        const address =
            addressBox.value.trim();


        if (address === "") {

            status.textContent =
                "Please enter an address first.";

            return;
        }


        status.textContent =
            "Searching for address...";


        fetch(
            "https://nominatim.openstreetmap.org/search?format=json&q="
            + encodeURIComponent(address)
            + "&limit=1"
        )

        .then(response => response.json())

        .then(data => {

            if (data.length === 0) {

                status.textContent =
                    "Address not found.";

                return;
            }


            latitudeBox.value =
                data[0].lat;

            longitudeBox.value =
                data[0].lon;

            addressBox.value =
                data[0].display_name;


            status.textContent =
                "Address found successfully.";

        })

        .catch(() => {

            status.textContent =
                "Unable to search the address.";

        });

    });

// ========================================
// AUTOMATIC PAYMENT STATUS
// ========================================

const totalFeeBox = document.getElementById("total_fee");
const amountPaidBox = document.getElementById("amount_paid");
const paymentStatusBox = document.getElementById("payment_status");

function updatePaymentStatus() {

    const totalFee = parseFloat(totalFeeBox.value) || 0;
    const amountPaid = parseFloat(amountPaidBox.value) || 0;

    if (amountPaid <= 0) {

        paymentStatusBox.value = "Pending";

    } else if (amountPaid < totalFee) {

        paymentStatusBox.value = "Partial";

    } else {

        paymentStatusBox.value = "Paid";
    }
}


// Update when Total Fee changes
totalFeeBox.addEventListener(
    "input",
    updatePaymentStatus
);


// Update when Amount Paid changes
amountPaidBox.addEventListener(
    "input",
    updatePaymentStatus
);

</script>