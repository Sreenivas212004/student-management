            </div>

            <div class="delete-user-form">

                <a
                    href="<?= $this->url('student', [
                        'action' => 'users'
                    ]) ?>"
                    class="btn btn-primary"
                >
                    Back to Users
                </a>

            </div>

        <?php endif; ?>

    </div>

