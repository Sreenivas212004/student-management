                            <td>

                                <span
                                    class="user-role-badge <?= $userRole === 'admin'
                                        ? 'role-admin'
                                        : 'role-user' ?>"
                                >

                                    <?= $this->escapeHtml(
                                        strtoupper($userRole)
                                    ) ?>

                                </span>

                            </td>


                            <!-- STATUS -->

                            <td>

                                <span
                                    class="user-status-badge <?= $isActive
                                        ? 'status-active'
