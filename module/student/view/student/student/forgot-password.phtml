<div class="auth-page">

    <div class="auth-card">

        <div class="auth-header">

            <div class="auth-icon">
                🔐
            </div>

            <h1>Forgot Password?</h1>

            <p>
                Enter your username to continue with password recovery.
            </p>

        </div>


        <?php if (!empty($error)): ?>

            <div class="alert alert-error">
                <?= $this->escapeHtml($error) ?>
            </div>

        <?php endif; ?>


        <?php if (!empty($success)): ?>

            <div class="alert alert-success">
                <?= $this->escapeHtml($success) ?>
            </div>

        <?php endif; ?>


        <?php if (!empty($message)): ?>

            <div class="alert alert-success">
                <?= $this->escapeHtml($message) ?>
            </div>

        <?php endif; ?>


        <form
            method="post"
            class="auth-form"
            action="<?= $this->url('student', [
                'action' => 'forgot-password'
            ]) ?>"
        >

            <div class="form-group">

                <label for="username">
                    Username
                    <span class="required">*</span>
                </label>

                <input
                    type="text"
                    id="username"
                    name="username"
                    value="<?= $this->escapeHtmlAttr($username ?? '') ?>"
                    placeholder="Enter your username"
                    required
                    autocomplete="username"
                >

            </div>


            <button
                type="submit"
                class="btn btn-primary auth-submit"
            >
                Continue
            </button>

        </form>


        <div class="auth-footer">

            <a
                href="<?= $this->url('student', [
                    'action' => 'login'
                ]) ?>"
                class="auth-link"
            >
                ← Back to Login
            </a>

        </div>

    </div>

</div>