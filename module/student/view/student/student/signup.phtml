<!-- CONFIRM PASSWORD -->

<div class="form-group">

    <label for="confirm_password">
        Confirm Password
    </label>

    <div class="password-wrapper">

        <input
            type="password"
            id="confirm_password"
            name="confirm_password"
            placeholder="Re-enter password"
            autocomplete="new-password"
            required
        >

        <button
            type="button"
            class="password-toggle"
            id="toggleConfirmPassword"
        >
